// Same layout as server/wrangler.jsonc (Hono's cloudflare-workers template).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skipass-demo",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-03",
  "vars": {
    "SERVICE_NAME": "Acme",
    // The demo mailbox. Left empty here so no address is committed; pass it at deploy time with
    // `npm run deploy -- --var DEMO_TO:<address>` (see README.md). Empty = /send answers 500.
    "DEMO_TO": "",
    // Without a verified domain this sender can only reach the Resend account owner's address.
    "MAIL_FROM": "onboarding@resend.dev",
    // "resend" sends through the Resend API; "log" prints the code to the console (local dev).
    "MAILER": "resend"
  },
  "kv_namespaces": [
    {
      "binding": "CODES",
      // Replace with the id printed by `npx wrangler kv namespace create CODES` (see README.md).
      "id": "00000000000000000000000000000000"
    }
  ]
  // Secrets (not in this file): RESEND_API_KEY, SESSION_SECRET.
  // Set with `npx wrangler secret put <NAME>`; locally use .dev.vars (see .dev.vars.example).
}
